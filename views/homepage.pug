doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet" href="/css/style.css")
    body
        a(href="/update-cobj") Add to this table
        h1 Bikes
        table
            thead
                tr
                    th Name
                    th Brand
                    th Colour
            tbody
                each bike in data
                    tr
                        td= bike.properties.name
                        td= bike.properties.brand
                        td= bike.properties.colour